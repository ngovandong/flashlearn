REACT_APP_BASE_URL=http://127.0.0.1:8005/api/
REACT_APP_CRAWLER_URL=http://127.0.0.1:8005/api
REACT_APP_SOCKET_URL=127.0.0.1:8005/ws

# Client timeout (ms) for endpoints that call an external AI provider (Speaking
# Coach, term AI enrich). They can queue behind the backend rate-limit gate, so
# this is generous by default (4 min). Other requests have no client timeout.
# REACT_APP_AI_REQUEST_TIMEOUT=240000


REACT_APP_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx

# Cloudinary
REACT_APP_CLOUD_NAME=xxxxxxxxx
REACT_APP_UPLOAD_PRESET=xxxxxxxxx
