{
  "name": "flashlearn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run start -w @flashlearn/web",
    "dev:mobile": "npm run start -w @flashlearn/mobile",
    "build:web": "npm run build -w @flashlearn/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
