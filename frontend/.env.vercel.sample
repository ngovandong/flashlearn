# Copy to Vercel Project Settings → Environment Variables
# (or use `vercel env pull` locally as .env.vercel — do not commit secrets)

# Frontend calls same-origin /api/* on Vercel; vercel.json rewrites proxy to your real backend.
REACT_APP_BASE_URL=https://flashlearn.vercel.app/api/
REACT_APP_CRAWLER_URL=https://flashlearn.vercel.app/api/

# WebSockets cannot be proxied through Vercel — Quick Revise multiplayer still needs
# a direct connection to your backend (or another WS-capable proxy).
REACT_APP_SOCKET_URL=flashlearnapi.ngovandong.site/ws

REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary (client-side uploads)
REACT_APP_CLOUD_NAME=your_cloudinary_cloud_name
REACT_APP_UPLOAD_PRESET=your_upload_preset

# Optional: used by frontend/middleware.js (Edge proxy). Falls back to flashlearnapi.ngovandong.site.
BACKEND_UPSTREAM=https://flashlearnapi.ngovandong.site
