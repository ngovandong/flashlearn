# Expo inlines EXPO_PUBLIC_* variables at build time. Copy to .env.local.
# On a physical device use your machine's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8005/api/

# Client timeout (ms) for AI-backed endpoints (generous by default — 4 min).
# EXPO_PUBLIC_AI_REQUEST_TIMEOUT=240000

# Google Sign-In client IDs (from Google Cloud OAuth). The web client ID is used
# to request an ID token; the iOS/Android IDs are the native OAuth clients.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# WebSocket base URL for realtime features (quick-revise game). Use ws:// on
# local dev; wss:// in production. On a physical device use your LAN IP.
EXPO_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8005/ws
