{
    "compilerOptions": {
      "baseUrl": ".",
      "paths": {
        "@components/*": ["src/components/*"],
        "@utils/*": ["src/utils/*"],
        "@styles/*": ["src/styles/*"],
        "@constants/*": ["src/constants/*"],
        "@app/*": ["src/app/*"],
        "@pages/*": ["src/pages/*"],
        "@api-services/*": ["src/api-service/*"],
        "@hooks/*": ["src/hooks/*"],
        "@flashlearn/core": ["../../packages/core/src"],
        "@flashlearn/api": ["../../packages/api/src"],
        "@flashlearn/auth": ["../../packages/auth/src"]
      }
    },
    "exclude": ["node_modules", "dist"]
  }
  