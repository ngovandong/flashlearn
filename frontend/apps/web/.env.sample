VITE_BASE_URL=http://127.0.0.1:8005/api/
VITE_CRAWLER_URL=http://127.0.0.1:8005/api
VITE_SOCKET_URL=127.0.0.1:8005/ws

# Client timeout (ms) for endpoints that call an external AI provider (Speaking
# Coach, term AI enrich). They can queue behind the backend rate-limit gate, so
# this is generous by default (4 min). Other requests have no client timeout.
# VITE_AI_REQUEST_TIMEOUT=240000


VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx

# Cloudinary
VITE_CLOUD_NAME=xxxxxxxxx
VITE_UPLOAD_PRESET=xxxxxxxxx

# Sentry (leave unset to disable error reporting)
# VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@xxxxxx.ingest.us.sentry.io/xxxxxxxxxx
