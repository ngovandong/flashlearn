# Server
BIND_HOST=0.0.0.0
PORT=8005

# MySQL (either DATABASE_URL or separate vars)
# DATABASE_URL=mysql://user:pass@host:3306/dbname
DB_USER=flashlearn
DB_PASSWORD=secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flashlearn

# Redis (or REDIS_URL=redis://127.0.0.1:6379/)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SKIP_REDIS=0

# Elasticsearch
ELASTIC_SEARCH_HOST=localhost
ELASTIC_SEARCH_PORT=9200

# Security (must match Django SECRET_KEY for existing JWTs)
SECRET_KEY=change-me

# JWT (seconds)
JWT_ACCESS_LIFETIME_SECS=1800
JWT_REFRESH_LIFETIME_SECS=2592000
PBKDF2_ITERATIONS=600000

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URLs
BASE_FRONTEND_URL=http://localhost:3000
BASE_BACKEND_URL=http://localhost:8005

# Migrate parity tests (`cargo test --test migrate_tests`)
# Same MySQL as above; run Django + Rust against this DB, then:
# LEGACY_API_BASE_URL=http://127.0.0.1:8000
# RUST_API_BASE_URL=http://127.0.0.1:8005
# MIGRATE_TEST_ACCESS_TOKEN=<JWT access>   # optional; same user works on both if SECRET_KEY matches
# MIGRATE_TEST_USER_EMAIL=user@example.com
# MIGRATE_TEST_USER_PASSWORD=secret
# MIGRATE_TEST_INSPECT=1   # optional: print backend_* row counts before tests

# Google OAuth (optional)
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# Cloudinary (optional; term image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Timezone for “today” in learning stats (IANA name)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cache TTLs
LEARNING_PROGRESS_CACHE_TTL_SECS=300
# USER_CACHE_TTL_SECS=86400

REST_PAGE_SIZE=20

# Optional SMTP for future activation emails
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
