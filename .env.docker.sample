MYSQL_DATABASE=flashlearn
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=host.docker.internal
DB_PORT=3306
DEBUG=True
CORS_ALLOW_ALL_ORIGINS=True

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
ALLOWED_HOSTS=*

SECRET_KEY=your_django_secret_key
BASE_FRONTEND_URL=http://127.0.0.1:3001
BASE_BACKEND_URL=http://127.0.0.1:8005

GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret

# mail
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

ABSTRACT_API_KEY=your_abstract_api_key

# cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


DRIVE_TOKEN_PATH=/drive-token.json
DRIVE_CREDENTIALS_PATH=/drive-credentials.json
DRIVE_BACKUP_FOLDER_ID=xxxxxxxx
