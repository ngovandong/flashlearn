DEBUG=True
SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CORS_ALLOW_ALL_ORIGINS=True
BASE_FRONTEND_URL=https://flashlearn.ngovandong.site
BASE_BACKEND_URL=https://flashlearnapi.ngovandong.site

GOOGLE_OAUTH2_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_OAUTH2_CLIENT_SECRET=xxxxxxxxxxxxxxxxxx
# AI provider (provider-agnostic). AI_PROVIDER selects the primary client and
# AI_FALLBACK_PROVIDERS lists backups tried in order when the primary fails.
AI_PROVIDER=gemini
# AI_FALLBACK_PROVIDERS=openrouter
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Per-request timeout (s) and retry count for transient 429/5xx/timeout
# GEMINI_TIMEOUT=90
# GEMINI_MAX_RETRIES=5
# Max single backoff sleep (s); must cover free-tier 429 retry-after (~60s)
# GEMINI_MAX_BACKOFF=65
# Min seconds between requests to stay under the free-tier RPM quota.
# Free tier gemini-3.1-flash-lite allows few requests/min — set ~6 to be safe.
# GEMINI_MIN_INTERVAL=6
# OpenRouter (OpenAI-compatible) backup provider. Free-tier model forced by
# default; set OPENROUTER_FORCE_FREE=false to allow paid models.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_FORCE_FREE=true
# LM Studio — run text AI on a LOCAL model (OpenAI-compatible server), no cloud
# quotas. Use AI_PROVIDER=lmstudio (optionally keep a cloud AI_FALLBACK_PROVIDERS).
# Start LM Studio's local server, load a model, then:
# LMSTUDIO_API_BASE=http://localhost:1234/v1
# LMSTUDIO_MODEL=qwen2.5-14b-instruct   # the model id shown in LM Studio
# LMSTUDIO_TIMEOUT=300                   # local models are slower; be generous
# LMSTUDIO_API_KEY=lm-studio             # ignored by LM Studio; any non-empty value
# Azure OpenAI (OpenAI-compatible v1 API) — cloud text AI. Use AI_PROVIDER=azure_openai.
# ENDPOINT must end in /openai/v1; DEPLOYMENT is the model deployment name you
# create in Azure AI Foundry → Deployments (e.g. gpt-4.1).
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Azure AI Speech — Pronunciation Assessment for the Speaking Coach. When both
# vars are set, recorded speech is scored with Azure's measured accuracy /
# fluency / completeness / prosody + word & phoneme detail; otherwise the coach
# falls back to the multimodal AI listener.
# AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_SPEECH_REGION=southeastasia
# AZURE_SPEECH_LANGUAGE=en-US
# AZURE_SPEECH_TIMEOUT=30
# AZURE_SPEECH_MAX_RETRIES=2

# ElevenLabs — active Speaking Coach TTS provider (Gemini's TTS is kept as a
# legacy fallback for conversations generated with its prebuilt voices). When
# ELEVENLABS_API_KEY is set, new conversations use ElevenLabs voices.
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2   # or eleven_flash_v2_5 for lower latency
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1
# ELEVENLABS_TIMEOUT=90
# ELEVENLABS_MAX_RETRIES=2
# ElevenLabs skips the global rate-limit gate by default (no throttle/delay) since
# its limits are concurrency/credits, not a tight RPM. Re-enable it if you hit limits:
# AI_GATE_ENABLED_ELEVENLABS=true
# AI_GATE_RPM_ELEVENLABS=60
# Failover tuning: how fast the primary gives up, and how long a failed
# provider is skipped before being retried.
# AI_PRIMARY_MAX_RETRIES=1
# AI_PROVIDER_COOLDOWN=120
# Global AI gate: a Redis-backed lock + sliding-window limiter shared by every
# process (web workers, RQ worker, cron) so provider calls run one-at-a-time and
# never exceed the free-tier per-minute quota. Falls back to an in-process
# limiter when Redis is unavailable. RPM/lock-ttl/max-wait can be set per
# provider with an _<LABEL> suffix, e.g. AI_GATE_RPM_GEMINI / AI_GATE_RPM_OPENROUTER.
# AI_GATE_ENABLED=true
# AI_GATE_RPM=15            # max requests per minute per provider (Gemini free tier)
# AI_GATE_RPM_GEMINI=15
# AI_GATE_MAX_WAIT=120      # seconds a request queues before proceeding anyway
# AI_GATE_LOCK_TTL_MS=180000
# Unique term names per AI request / names per cron tick
# AI_ENRICH_BATCH=20
# AI_CRON_MAX_NAMES=40

# Behind a TLS-intercepting proxy/VPN (e.g. Zscaler)? Point this at the proxy's
# root CA PEM so outbound HTTPS verifies. Merged with certifi automatically.
# EXTRA_CA_CERTS=/path/to/Zscaler-root-ca.pem
# Escape hatches for the Gemini client only:
# GEMINI_CA_BUNDLE=/path/to/ca.pem
# GEMINI_VERIFY_SSL=false   # disables TLS verification (debug only, not for prod)
# mail
EMAIL_HOST_PASSWORD=xxxxxxxxxx
ABSTRACT_API_KEY=xxxxxxxxxxxxx
#cloudinary
CLOUDINARY_CLOUD_NAME=xxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxx
# mysql
DB_NAME=flashlearn
DB_USER=root
DB_PASSWORD=xxxxxx
DB_HOST=127.0.0.1
DB_PORT=3306
# redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Image crawler — set to 1 on very low-memory hosts to skip Google Playwright (~150MB RAM)
# CRAWLER_GOOGLE_SKIP_PLAYWRIGHT=1

# Term image base64 cron — max raw bytes before compression; max longest edge in pixels
# TERM_IMAGE_MAX_BYTES=200000
# TERM_IMAGE_MAX_DIMENSION=800

DRIVE_TOKEN_PATH=drive-token.json
DRIVE_CREDENTIALS_PATH=drive-credentials.json
DRIVE_BACKUP_FOLDER_ID=xxxxxxxx
