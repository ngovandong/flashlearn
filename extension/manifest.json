{
  "manifest_version": 3,
  "name": "Flashlearn Extension",
  "description": "Extension for flashlearn website",
  "version": "2.0.2",
  "action": {
    "default_popup": "index.html",
    "default_icon": "images/icon-32.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/chrome/contentScript.js"]
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://flashlearn.ngovandong.site/*",
        "https://flashlearn.vercel.app/*"
      ],
      "js": ["src/chrome/loginScript.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["pageTokenBridge.js"],
      "matches": [
        "http://localhost:3000/*",
        "https://flashlearn.ngovandong.site/*",
        "https://flashlearn.vercel.app/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/chrome/background.js",
    "type": "module"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8005/*",
    "http://localhost:8005/*",
    "http://localhost:3000/*",
    "https://flashlearn.ngovandong.site/*",
    "https://flashlearn.vercel.app/*",
    "https://translate.google.com/*"
  ]
}
